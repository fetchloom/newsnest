# The domain people will use to reach Newsnest, e.g. news.example.com
NEWSNEST_DOMAIN=news.example.com
NEWSNEST_PUBLIC_URL=https://news.example.com

# Password for the dashboard (at least 10 characters). Remove it after your first sign-in if you change it in Settings.
NEWSNEST_ADMIN_PASSWORD=

# How mail leaves: relay (hand off to an SMTP service) or direct (send yourself, needs port 25 and a clean IP).
NEWSNEST_MODE=relay
NEWSNEST_RELAY_URL=smtps://username:password@smtp.example.com:465
